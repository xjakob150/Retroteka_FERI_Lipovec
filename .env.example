# Kopirajte v .env in vpišite svoje vrednosti: cp .env.example .env

# PostgreSQL
POSTGRES_DB=retroteka
POSTGRES_USER=retroteka
POSTGRES_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# IGDB (Twitch Developer: https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# eBay Browse API (https://developer.ebay.com/my/keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Frontend
VITE_API_URL=http://localhost:8000/api
